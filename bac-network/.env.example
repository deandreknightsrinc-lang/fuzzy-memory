# Copy this file to .env and fill in every value.

# Your domain name, without www (for example bacnetwork.com)
DOMAIN=bacnetwork.com
# Email for HTTPS certificates and the video library admin account
ADMIN_EMAIL=you@example.com

# Make up long random passwords (run: openssl rand -hex 24)
MYSQL_ROOT_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
PEERTUBE_SECRET=change-me

# Email sending, for newsletters, sign-ups and password resets.
# Mailgun, Postmark or Brevo all work.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.bacnetwork.com
SMTP_PASS=change-me
MAIL_FROM=BAC Network <noreply@bacnetwork.com>
